# One public address serves everything: the web app, and the API under /api.
# TLS certificates are obtained and renewed automatically.
# For a staging box without public DNS, set CADDY_GLOBAL_OPTIONS=local_certs to use Caddy's own CA.
{
  {$CADDY_GLOBAL_OPTIONS}
}

{$APP_ADDRESS} {
  encode zstd gzip

  @api path /api/* /health /ready
  handle @api {
    request_body {
      max_size 60MB
    }
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:8080
  }
}
