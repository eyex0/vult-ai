# Copy to .env.production and fill in. Use long random values: openssl rand -hex 32
# Passwords: letters and digits only (they are written into SQL and URLs).

# The public address of Vult. The web app and the API (under /api) are both served here.
# No domain yet? Use your server's IP with sslip.io, e.g. 203-0-113-10.sslip.io
APP_DOMAIN=app.example.com

# Shown on the website, in the privacy policy and the terms.
CONTACT_EMAIL=hello@example.com
LEGAL_ENTITY=Example S.r.l., Via Roma 1, 20100 Milano, P.IVA 01234567890

POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
JWT_SECRET=

# true lets anyone create a workspace; false for invitation-only beta.
SIGNUP_ENABLED=true

# Optional: early-access requests are also sent here (Slack incoming webhook, Make, Zapier).
LEADS_WEBHOOK_URL=

# Image names when pushing to a registry, e.g. ghcr.io/your-org/vult
IMAGE_PREFIX=vult
VERSION=latest

# --profile sdi: invoices arriving from an SDI intermediary into S3-compatible storage
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --profile ai: memory search
OPENAI_API_KEY=
AI_SERVICE_TOKEN=
